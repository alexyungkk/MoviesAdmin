@using Microsoft.AspNetCore.Html
@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Details";
}

<h1 class="mb-4">Details - @Html.DisplayFor(model => model.Title)</h1>

<img src="@Model.ImageUrl" alt="@Model.Title" class="w-25" />

<div>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Synopsis)
        </dt>
        <dd class = "col-sm-10" style="text-align:justify;">
            @* @Html.DisplayFor(model => model.Synopsis) *@
            @{
            var synopsisWithBreaks = new HtmlString(Model.Synopsis
            .Replace("\r\n", "<br />")
            .Replace("\n", "<br />")
            .Replace("\r", "<br />")
            );
            }
            @synopsisWithBreaks
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Genre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Genre.Title)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AudienceRating)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AudienceRating.Title)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Rating)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Rating)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Runtime)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Runtime)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RelaseDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RelaseDate)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
